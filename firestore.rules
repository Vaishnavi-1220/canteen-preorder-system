
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          '23wh1a1220@bvrithyderabad.edu.in'
        ];
    }

    match /menu/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /orders/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'token', 'items',
          'total', 'pickup', 'status', 'ts'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'placed'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.pickup is string
        && request.resource.data.token is string
        && request.resource.data.ts == request.time;

      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['status']);

      allow delete: if isAdmin();
    }
  }
}
